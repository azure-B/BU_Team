PORT=5000
NODE_ENV=development


# JWT 시크릿 (반드시 변경하세요!)
JWT_SECRET=change_this_secret_key_in_production
JWT_EXPIRES_IN=7d

# CORS 허용 출처
CORS_ORIGIN=http://localhost:3000

# Supabase 연동 정보
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 카카오 REST API 키 (도보 길찾기 — 서버 전용, 지도 UI 미사용)
# 없으면 GPS→목적지 직선거리로 도보 분을 추정합니다.
KAKAO_REST_API_KEY=

# OpenAI (백석AI 비서 · RAG — 서버 전용, Front/VITE_ 에 넣지 말 것)
# 실제 값은 프로젝트 루트 `.env`에만 둔다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
DAILY_BUDGET_USD=1
MAX_OUTPUT_TOKENS=800

